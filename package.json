{
  "name": "foab-bot",
  "version": "0.1.0",
  "description": "Bot de Discord para kills/deaths y asistencia de batallas de Albion Online",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "deploy:dev": "node src/deploy-commands.js guild",
    "deploy:prod": "node src/deploy-commands.js global",
    "deploy:clean": "node src/deploy-commands.js clean",
    "test": "node --test \"src/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "verify:sheets": "node scripts/sheets-verify.mjs"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "google-auth-library": "^11.0.2"
  }
}
