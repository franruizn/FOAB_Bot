# Token del bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Application ID del bot (Discord Developer Portal > General Information)
CLIENT_ID=

# ID del servidor de Discord de DESARROLLO: donde npm run deploy:dev registra
# los slash commands (al instante) y el que limpia npm run deploy:clean. En
# producción los comandos son globales (npm run deploy:prod) y no lo usan.
#
# También lo usa la migración a multiservidor, UNA sola vez: si DATA_DIR
# todavía tiene la estructura vieja (squads.json suelto), sus datos se mueven
# a DATA_DIR/guilds/<GUILD_ID>/. Si en ese momento falta, el bot no arranca:
# mover los datos al servidor equivocado es peor que no arrancar.
GUILD_ID=

# Opcional. A qué alcance registra los slash commands "npm run deploy:*":
# guild (por defecto, requiere GUILD_ID) | global | clean. Normalmente no
# hace falta tocarlo aquí: los scripts de package.json ya lo pasan como
# argumento (deploy:dev -> guild, deploy:prod -> global, deploy:clean ->
# clean); esta variable es solo el fallback si lo lanzas a mano sin argumento.
DEPLOY_SCOPE=

# Opcional pero MUY recomendado. Zona horaria IANA del gremio (ej.
# "Europe/Madrid"), variable ESTÁNDAR de Docker/Linux — el bot no lee
# ninguna variable propia para esto. Sin ella, el proceso usa la zona
# horaria del sistema (normalmente UTC en un contenedor) y la hora de los
# logs estructurados de index.js dejaría de coincidir con la hora real a la
# que un oficial ve pasar las cosas.
TZ=

# Directorio persistente. Cada servidor de Discord tiene ahí su carpeta
# guilds/<guildId>/ con su config.json (rol de oficiales, canal de logs,
# gremio de Albion...), squads.json, raffles.json y backups/. Esa
# configuración es POR SERVIDOR y ya no se pone en este .env. En local
# no hace falta tocarlo (por defecto ./data). En Docker se fija a /data desde
# docker-compose.yml (el volumen), no desde este .env.
DATA_DIR=

# Opcional. ID de USUARIO de Discord (no de rol) de la única persona que
# puede usar /dm (mensaje privado a varias personas a la vez). Ni el rol de
# oficiales ni ser administrador sirven: solo este id. Si está vacío, /dm
# queda DESACTIVADO por completo. Cuidado: los DMs masivos son el principal
# vector de spam de Discord y un par de reportes pueden desactivar la
# aplicación ENTERA (sorteos, todo).
DM_OWNER_ID=

# ID del SERVIDOR (no de usuario) donde está DM_OWNER_ID. /dm se registra
# como comando de ese servidor y de ningún otro: global, saldría en la lista
# de todos los servidores y cualquiera que lo probara recibiría un rechazo.
# Sin esto, npm run deploy:prod no registra /dm en ninguna parte. Esto solo
# decide DÓNDE se ve /dm; quién puede usarlo sigue siendo DM_OWNER_ID.
DM_GUILD_ID=

# Opcional. Lista de ids de servidor separados por comas. Si está definida,
# el bot sale automáticamente de cualquier servidor que no esté en ella (al
# entrar, y al arrancar de los que ya esté) y lo deja en el log. Vacía:
# acepta cualquier servidor. Evita que el bot acabe funcionando donde no lo
# controlas si alguien comparte el enlace de invitación.
ALLOWED_GUILD_IDS=
