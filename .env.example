# Token del bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Application ID del bot (Discord Developer Portal > General Information)
CLIENT_ID=

# ID del servidor de Discord donde se registran los slash commands
GUILD_ID=

# ID del rol con permiso para editar squads (/squads agregar|quitar|mover)
OFFICER_ROLE_ID=

# Servidor de Albion: europe | americas | asia
ALBION_SERVER=

# ID interno del gremio en albionbb, usado para consultar asistencia
ALBIONBB_GUILD_ID=

# Directorio persistente donde vive squads.json y config/backups/. En local
# no hace falta tocarlo (por defecto ./data). En Docker se fija a /data desde
# docker-compose.yml (el volumen), no desde este .env.
DATA_DIR=

# Opcional. Canal de Discord donde se avisa de cada cambio hecho con /squads
# y de cada error no controlado. Déjalo vacío para desactivarlo.
LOG_CHANNEL_ID=

# Opcional. Si está definido, el anuncio de /sorteo menciona (pinga) este rol
# además de a quien lo creó. Para que la mención pinge de verdad, el rol debe
# ser "mentionable" o el bot necesita permiso de "Mention @everyone". Déjalo
# vacío para que el anuncio no mencione ningún rol.
RAFFLE_ROLE_ID=

# Opcionales, ambas o ninguna. Si faltan, las CTAs funcionan igual pero sin
# sincronizar con Google Sheets (/cta sync avisa de que está desactivado).
#
# GOOGLE_CREDENTIALS_PATH: ruta al JSON de credenciales de una cuenta de
# servicio de Google con acceso de editor a la hoja (Sheets API habilitada
# en el proyecto de Google Cloud, hoja compartida con el email de la cuenta
# de servicio).
# CTA_SHEET_ID: el ID de esa hoja (el trozo entre /d/ y /edit en su URL).
#
# AVISO DE COMPATIBILIDAD: si vienes de una versión anterior del bot, el
# formato de la hoja CAMBIÓ y NO es compatible con el anterior. Antes había
# un único bloque fijo (CTA_RANGO_INICIO) de 4 columnas (nombre + 3 roles de
# texto libre) compartido por todas las CTAs, lo que hacía que dos eventos
# simultáneos se pisaran las celdas entre sí. Ahora cada CTA crea su PROPIA
# pestaña (nombrada como su rol de Discord: "<nombre>_<ddMM-HHmm>") con 5
# columnas: nombre, rol asignado, party, roles que puede jugar, tentativo.
# Si ya usabas la hoja con el formato viejo, esas pestañas/rangos no se van
# a tocar ni a migrar: las CTAs nuevas simplemente crean las suyas.
#
# La pestaña se crea y se escribe UNA SOLA VEZ, al cerrar la CTA (no en cada
# alta/movimiento mientras está abierta). Si ese volcado falla, la CTA
# cerrada queda marcada como pendiente y /cta sync, lanzado en su canal, lo
# reintenta.
GOOGLE_CREDENTIALS_PATH=
CTA_SHEET_ID=
